# Supabase — template for collaborators. Copy to .env.local and fill in.
# Only publishable (anon) values belong here. Never put the service-role key
# in any VITE_ variable: everything VITE_ prefixed is bundled into the
# public JavaScript that ships to the browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
